# Skillora AI - Environment Configuration Template
# Copy this file to .env and configure as needed.

# =====================================================================
# Local Open-Weight AI (Gemma 3:1B via Ollama)
# 100% Private, zero cloud calls, zero paid API keys
# =====================================================================
# Local Ollama HTTP API endpoint (Default: http://localhost:11434)
OLLAMA_BASE_URL=http://localhost:11434

# Target local model (Default: gemma3:1b)
OLLAMA_MODEL=gemma3:1b

# Request timeout in seconds (Default: 25)
OLLAMA_TIMEOUT=25

# =====================================================================
# Persistence & Database Configuration
# =====================================================================
# SQLite Database path (Defaults to skillora.db in the project root)
SKILLORA_DB_PATH=skillora.db
